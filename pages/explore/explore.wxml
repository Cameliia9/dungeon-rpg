<!-- 探索地牢页面 -->
<view class="container">

  <!-- ========== 顶部：楼层标题 ========== -->
  <view class="card" style="text-align: center;">
    <text class="title">🏰 地牢第 {{player.floor}} 层</text>
    <text class="subtitle">小心前进...</text>
  </view>

  <!-- ========== 两个门 ========== -->
  <view style="display: flex; justify-content: space-between; gap: 12px; margin-bottom: 12px;">
    <view class="card" style="flex: 1; text-align: center; padding: 30px 10px; min-height: 160px; display: flex; flex-direction: column; align-items: center; justify-content: center;" bindtap="goLeft" data-disabled="{{!!activeEvent}}">
      <text style="font-size: 56px; display: block;">🚪</text>
      <text style="font-size: 16px; color: #c8c8d0; margin-top: 10px; display: block;">前进探索</text>
    </view>
    <view class="card" style="flex: 1; text-align: center; padding: 30px 10px; min-height: 160px; display: flex; flex-direction: column; align-items: center; justify-content: center;" bindtap="goRight" data-disabled="{{!!activeEvent}}">
      <text style="font-size: 56px; display: block;">🚪</text>
      <text style="font-size: 16px; color: #c8c8d0; margin-top: 10px; display: block;">前进探索</text>
    </view>
  </view>

  <!-- ========== 事件处理区（处理事件时显示，自动事件1.5s后消失） ========== -->
  <view wx:if="{{activeEvent}}" class="card">

    <!-- 怪物 -->
    <block wx:if="{{activeEvent.type === 'monster'}}">
      <text style="font-size: 36px; display: block; text-align: center;">👹</text>
      <text class="title">{{activeEvent.monster.name}} 出现了！</text>
      <text class="subtitle">{{activeEvent.monster.desc}}</text>
      <view class="stat-row"><text class="stat-label">血量</text><text class="stat-value">{{activeEvent.monster.hp}}</text></view>
      <view class="stat-row"><text class="stat-label">攻击</text><text class="stat-value">{{activeEvent.monster.attack}}</text></view>
      <button class="btn btn-primary" bindtap="goBattle">⚔️ 战斗！</button>
      <button class="btn btn-secondary" bindtap="runAway">🏃 逃跑（50%）</button>
    </block>

    <!-- 宝箱 -->
    <block wx:if="{{activeEvent.type === 'treasure'}}">
      <text style="font-size: 36px; display: block; text-align: center;">📦</text>
      <text class="title">发现了宝箱！</text>
      <text class="subtitle" style="color: #f0c040;">获得 {{activeEvent.gold}} 金币</text>
      <button class="btn btn-primary" bindtap="nextRound">好的</button>
    </block>

    <!-- 生命泉水 -->
    <block wx:if="{{activeEvent.type === 'spring'}}">
      <text style="font-size: 36px; display: block; text-align: center;">💧</text>
      <text class="title">生命泉水</text>
      <text class="subtitle" style="color: #2ecc71;">恢复了 {{activeEvent.heal}} 点生命</text>
      <button class="btn btn-primary" bindtap="nextRound">好的</button>
    </block>

    <!-- 陷阱机关 -->
    <block wx:if="{{activeEvent.type === 'trap'}}">
      <text style="font-size: 36px; display: block; text-align: center;">⚠️</text>
      <text class="title">{{trapResult.dodged ? '闪避成功！' : '触发陷阱！'}}</text>
      <text class="subtitle" wx:if="{{!trapResult.dodged}}" style="color: #e74c3c;">尖刺造成了 {{trapResult.damage}} 点伤害</text>
      <text class="subtitle" wx:if="{{trapResult.dodged}}" style="color: #2ecc71;">你敏捷地躲开了！</text>
      <button class="btn btn-primary" bindtap="nextRound">好的</button>
    </block>

    <!-- 迷途岔路 -->
    <block wx:if="{{activeEvent.type === 'deadend'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🚧</text>
      <text class="title">迷途岔路</text>
      <text class="subtitle" style="color: #8a8a9a;">死胡同，安全返回</text>
      <button class="btn btn-primary" bindtap="nextRound">好的</button>
    </block>

    <!-- 散落金币 -->
    <block wx:if="{{activeEvent.type === 'coins'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🪙</text>
      <text class="title">散落金币</text>
      <text class="subtitle" style="color: #f0c040;">捡到 {{activeEvent.gold}} 枚金币！</text>
      <button class="btn btn-primary" bindtap="nextRound">好的</button>
    </block>

    <!-- 增益石碑 -->
    <block wx:if="{{activeEvent.type === 'buffStone'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🗿</text>
      <text class="title">增益石碑</text>
      <text class="subtitle" style="color: #e0c080;">攻击力 +{{activeEvent.attackBonus}}！（本次探索有效）</text>
      <button class="btn btn-primary" bindtap="nextRound">好的</button>
    </block>

    <!-- 神秘商人 -->
    <block wx:if="{{activeEvent.type === 'merchant'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🧙</text>
      <text class="title">神秘商人</text>
      <text class="subtitle">"冒险者，看看我的货物！"</text>
      <view wx:for="{{activeEvent.items}}" wx:key="name" style="margin: 8px 0; padding: 8px; background: #1a1a2e; border-radius: 8px;">
        <view class="flex-between">
          <view>
            <text style="color: #e0c080;">{{item.name}}</text>
            <text style="color: #8a8a9a; font-size: 12px; display: block;">{{item.desc}}</text>
          </view>
          <view style="text-align: right;">
            <text style="color: #f0c040;">💰{{item.price}}</text>
            <button class="btn btn-gold" style="padding: 4px 12px; font-size: 12px; margin-top: 2px;" bindtap="buyItem" data-index="{{index}}">购买</button>
          </view>
        </view>
      </view>
      <button class="btn btn-secondary" bindtap="nextRound">🚶 离开商人</button>
    </block>

    <!-- 休息营地 -->
    <block wx:if="{{activeEvent.type === 'camp'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🏕️</text>
      <text class="title">休息营地</text>
      <text class="subtitle">可以在此休息恢复生命</text>
      <text style="color: #e74c3c; display: block; text-align: center; margin: 6px 0;">⚠️ 30%概率遭遇巡逻怪物</text>
      <button class="btn btn-primary" bindtap="doRest">🛌 休息（回满生命）</button>
      <button class="btn btn-secondary" bindtap="nextRound">🚶 离开</button>
    </block>

    <!-- 遗物祭坛 -->
    <block wx:if="{{activeEvent.type === 'altar'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🔮</text>
      <text class="title">遗物祭坛</text>
      <text class="subtitle">献祭 {{activeEvent.sacrifice}} 点生命，换取力量</text>
      <button class="btn btn-primary" bindtap="altarSacrifice" data-type="attack">⚔️ +1 攻击力</button>
      <button class="btn btn-primary" bindtap="altarSacrifice" data-type="defense">🛡️ +1 防御力</button>
      <button class="btn btn-secondary" bindtap="nextRound">🚶 离开</button>
    </block>

    <!-- 破旧装备 -->
    <block wx:if="{{activeEvent.type === 'oldGear'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🦺</text>
      <text class="title">破旧装备</text>
      <text class="subtitle">翻到一件还能用的旧装备</text>
      <button class="btn btn-primary" bindtap="wearOldGear">👔 穿上（+{{activeEvent.defense}}防）</button>
      <button class="btn btn-primary" bindtap="scrapOldGear">🔧 拆解（+{{activeEvent.gold}}金）</button>
      <button class="btn btn-secondary" bindtap="nextRound">🚶 不理会</button>
    </block>

    <!-- 营地遭遇怪物 -->
    <block wx:if="{{activeEvent.type === 'camp_ambush'}}">
      <text style="font-size: 36px; display: block; text-align: center;">👹</text>
      <text class="title">{{activeEvent.monster.name}} 突袭了营地！</text>
      <text class="subtitle">{{activeEvent.monster.desc}}</text>
      <view class="stat-row"><text class="stat-label">血量</text><text class="stat-value">{{activeEvent.monster.hp}}</text></view>
      <view class="stat-row"><text class="stat-label">攻击</text><text class="stat-value">{{activeEvent.monster.attack}}</text></view>
      <button class="btn btn-primary" bindtap="goBattle">⚔️ 战斗！</button>
      <button class="btn btn-secondary" bindtap="runAway">🏃 逃跑（50%）</button>
    </block>

  </view>

  <!-- 下楼 -->
  <view wx:if="{{canDescend}}" class="card" style="text-align: center;">
    <text style="font-size: 40px; display: block;">🪜</text>
    <text class="title">发现通往下层的楼梯！</text>
    <button class="btn btn-gold" bindtap="descend">
      ⬇️ 前往第 {{player.floor + 1}} 层
    </button>
  </view>

  <!-- ========== 底部状态栏 ========== -->
  <view class="card" style="position: fixed; bottom: 0; left: 0; right: 0; margin: 0; border-radius: 12px 12px 0 0; padding: 12px 16px; z-index: 100;">
    <view class="flex-between">
      <view style="flex: 1; margin-right: 12px;">
        <view class="stat-row">
          <text class="stat-label">❤️ {{player.hp}} / {{totalMaxHp}}</text>
        </view>
        <view class="hp-bar-wrap" style="margin: 4px 0;">
          <view class="hp-bar-fill" style="width: {{player.hp / totalMaxHp * 100}}%"></view>
        </view>
        <view class="stat-row">
          <text class="stat-label">⚔️ {{totalAttack}}攻  🛡️ {{totalDefense}}防</text>
        </view>
        <view class="stat-row" style="margin-top: 2px;">
          <text class="stat-label">💰 {{player.gold}}金币  ⭐ {{player.exp}} / {{expToLevel}}经验</text>
        </view>
      </view>
      <button class="btn btn-secondary" style="width: auto; padding: 8px 18px; margin: 0; font-size: 14px;" bindtap="exitExplore">
        🚪 退出
      </button>
    </view>
  </view>

  <view style="height: 100px;"></view>

</view>
