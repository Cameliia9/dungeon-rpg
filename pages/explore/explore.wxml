<!-- 探索地牢页面 -->
<view class="container">

  <!-- ========== 顶部：楼层标题 ========== -->
  <view class="card" style="text-align: center;">
    <text class="title">🏰 地牢第 {{player.floor}} 层</text>
    <text class="subtitle">小心前进...</text>
    <text class="subtitle" style="font-size: 12px; color: #6a6a7a;">已探索 {{player.roomsExplored}} / {{ROOMS_PER_FLOOR}} 个房间</text>
  </view>

  <!-- ========== 两个门 ========== -->
  <view style="display: flex; justify-content: space-between; gap: 12px; margin-bottom: 12px;">

    <!-- ===== 左卡片区域 ===== -->
    <view style="flex: 1; position: relative; min-height: 200px;">

      <!-- 叠层幽灵卡片（门状态时显示） -->
      <block wx:if="{{leftState === 'door'}}">
        <view wx:if="{{leftDepth >= 4}}" class="ghost-card"
          style="transform: translate(-11px, 11px) scale(0.91); z-index: 1; opacity: 0.5;"></view>
        <view wx:if="{{leftDepth >= 3}}" class="ghost-card"
          style="transform: translate(-7px, 7px) scale(0.94); z-index: 2; opacity: 0.65;"></view>
        <view wx:if="{{leftDepth >= 2}}" class="ghost-card"
          style="transform: translate(-3px, 3px) scale(0.97); z-index: 3; opacity: 0.8;"></view>
      </block>

      <!-- 主卡片（交互层） -->
      <view class="card main-float {{leftOut ? 'fly-out-right' : ''}}"
        style="position: relative; z-index: 10; min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 20px 10px; overflow: visible;">

      <!-- 门状态 -->
      <block wx:if="{{leftState === 'door'}}">
        <text style="font-size: 48px; display: block;">🚪</text>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 14px;" bindtap="goLeft">前进探索</button>
      </block>

      <!-- 自动事件结果 -->
      <block wx:if="{{leftState === 'result'}}">
        <text style="font-size: 36px; display: block;">{{leftEvent.type === 'treasure' ? '📦' : leftEvent.type === 'spring' ? '💧' : leftEvent.type === 'trap' ? '⚠️' : leftEvent.type === 'deadend' ? '🚧' : leftEvent.type === 'coins' ? '🪙' : leftEvent.type === 'buffStone' ? '🗿' : '❓'}}</text>
        <text class="title" style="font-size: 16px;">{{leftEvent.type === 'treasure' ? '宝箱' : leftEvent.type === 'spring' ? '生命泉水' : leftEvent.type === 'trap' ? (trapResult.dodged ? '闪避成功' : '触发陷阱') : leftEvent.type === 'deadend' ? '迷途岔路' : leftEvent.type === 'coins' ? '散落金币' : leftEvent.type === 'buffStone' ? '增益石碑' : ''}}</text>
        <text class="subtitle" style="font-size: 12px; color: {{leftEvent.type === 'trap' && !trapResult.dodged ? '#e74c3c' : leftEvent.type === 'spring' ? '#2ecc71' : '#f0c040'}};">
          {{leftEvent.type === 'treasure' ? '获得' + leftEvent.gold + '金币' : leftEvent.type === 'spring' ? '恢复' + leftEvent.heal + '生命' : leftEvent.type === 'trap' ? (trapResult.dodged ? '毫发无伤' : '受到' + trapResult.damage + '伤害') : leftEvent.type === 'deadend' ? '死胡同，安全返回' : leftEvent.type === 'coins' ? '捡到' + leftEvent.gold + '金币' : leftEvent.type === 'buffStone' ? '攻击+' + leftEvent.attackBonus : ''}}
        </text>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 10px;" bindtap="finishLeft">好的</button>
      </block>

      <!-- 怪物 -->
      <block wx:if="{{leftState === 'monster'}}">
        <text style="font-size: 30px; display: block;">👹</text>
        <text style="font-size: 15px; font-weight: bold; color: #e0c080; margin: 2px 0;">{{leftEvent.monster.name}}</text>
        <text style="font-size: 11px; color: #8a8a9a; margin: 1px 0;">{{leftEvent.monster.desc}}</text>
        <text style="font-size: 12px; color: #8a8a9a; margin: 3px 0;">❤️{{leftEvent.monster.hp}}  ⚔️{{leftEvent.monster.attack}}</text>
        <button class="btn-sm btn-sm-primary" bindtap="goBattleLeft">⚔️ 战斗</button>
        <button class="btn-sm btn-sm-secondary" bindtap="runAwayLeft">🏃 逃跑</button>
      </block>

      <!-- 商人 -->
      <block wx:if="{{leftState === 'merchant'}}">
        <text style="font-size: 36px; display: block;">🧙</text>
        <text class="title" style="font-size: 16px;">神秘商人</text>
        <view wx:for="{{leftEvent.items}}" wx:key="name" style="margin: 4px 0; padding: 6px; background: #1a1a2e; border-radius: 6px; width: 100%;">
          <view class="flex-between">
            <text style="color: #e0c080; font-size: 12px;">{{item.name}}</text>
            <view>
              <text style="color: #f0c040; font-size: 11px;">💰{{item.price}}</text>
              <button class="btn-sm btn-sm-gold" style="padding: 2px 8px; font-size: 11px; margin-left: 4px;" bindtap="buyItemLeft" data-index="{{index}}">买</button>
            </view>
          </view>
        </view>
        <button class="btn-sm btn-sm-secondary" style="width: 80%; margin-top: 6px;" bindtap="finishLeft">离开</button>
      </block>

      <!-- 营地 -->
      <block wx:if="{{leftState === 'camp'}}">
        <text style="font-size: 36px; display: block;">🏕️</text>
        <text class="title" style="font-size: 16px;">休息营地</text>
        <text class="subtitle" style="font-size: 11px;">30%概率遇怪</text>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 6px;" bindtap="doRestLeft">🛌 休息</button>
        <button class="btn-sm btn-sm-secondary" style="width: 80%; margin-top: 4px;" bindtap="finishLeft">离开</button>
      </block>

      <!-- 祭坛 -->
      <block wx:if="{{leftState === 'altar'}}">
        <text style="font-size: 36px; display: block;">🔮</text>
        <text class="title" style="font-size: 16px;">遗物祭坛</text>
        <text class="subtitle" style="font-size: 11px;">献祭{{leftEvent.cost}}血（{{leftEvent.altarCount}}/{{leftEvent.maxCount}}次）</text>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 4px;" bindtap="altarLeft" data-type="attack" disabled="{{leftEvent.altarCount >= leftEvent.maxCount || player.hp <= leftEvent.cost}}">⚔️ +1攻击</button>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 2px;" bindtap="altarLeft" data-type="defense" disabled="{{leftEvent.altarCount >= leftEvent.maxCount || player.hp <= leftEvent.cost}}">🛡️ +1防御</button>
        <button class="btn-sm btn-sm-secondary" style="width: 80%; margin-top: 2px;" bindtap="finishLeft">离开</button>
      </block>

      <!-- 破旧装备 -->
      <block wx:if="{{leftState === 'oldGear'}}">
        <text style="font-size: 36px; display: block;">🦺</text>
        <text class="title" style="font-size: 16px;">破旧装备</text>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 4px;" bindtap="wearLeft">👔 穿上 +{{leftEvent.defense}}防</button>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 2px;" bindtap="scrapLeft">🔧 拆解 +{{leftEvent.gold}}金</button>
        <button class="btn-sm btn-sm-secondary" style="width: 80%; margin-top: 2px;" bindtap="finishLeft">不理会</button>
      </block>

      <!-- 营地遇怪 -->
      <block wx:if="{{leftState === 'camp_ambush'}}">
        <text style="font-size: 30px; display: block;">👹</text>
        <text style="font-size: 14px; font-weight: bold; color: #e0c080; margin: 2px 0;">{{leftEvent.monster.name}}突袭！</text>
        <text style="font-size: 12px; color: #8a8a9a; margin: 3px 0;">❤️{{leftEvent.monster.hp}}</text>
        <button class="btn-sm btn-sm-primary" bindtap="goBattleLeft">⚔️ 战斗</button>
        <button class="btn-sm btn-sm-secondary" bindtap="runAwayLeft">🏃 逃跑</button>
      </block>

      <!-- 楼梯 -->
      <block wx:if="{{leftState === 'stairs'}}">
        <text style="font-size: 36px; display: block;">🪜</text>
        <text style="font-size: 15px; font-weight: bold; color: #e0c080; margin: 6px 0;">发现楼梯！</text>
        <button class="btn-sm btn-sm-gold" bindtap="descend">⬇️ 下到 {{player.floor + 1}} 层</button>
      </block>

    </view>

    </view>

    <!-- ===== 右卡片区域 ===== -->
    <view style="flex: 1; position: relative; min-height: 200px;">

      <!-- 叠层幽灵卡片（门状态时显示） -->
      <block wx:if="{{rightState === 'door'}}">
        <view wx:if="{{rightDepth >= 4}}" class="ghost-card"
          style="transform: translate(-11px, 11px) scale(0.91); z-index: 1; opacity: 0.5;"></view>
        <view wx:if="{{rightDepth >= 3}}" class="ghost-card"
          style="transform: translate(-7px, 7px) scale(0.94); z-index: 2; opacity: 0.65;"></view>
        <view wx:if="{{rightDepth >= 2}}" class="ghost-card"
          style="transform: translate(-3px, 3px) scale(0.97); z-index: 3; opacity: 0.8;"></view>
      </block>

      <!-- 主卡片（交互层） -->
      <view class="card main-float {{rightOut ? 'fly-out-right' : ''}}"
        style="position: relative; z-index: 10; min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 20px 10px; overflow: visible;">

      <!-- 门状态 -->
      <block wx:if="{{rightState === 'door'}}">
        <text style="font-size: 48px; display: block;">🚪</text>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 14px;" bindtap="goRight">前进探索</button>
      </block>

      <!-- 自动事件结果 -->
      <block wx:if="{{rightState === 'result'}}">
        <text style="font-size: 36px; display: block;">{{rightEvent.type === 'treasure' ? '📦' : rightEvent.type === 'spring' ? '💧' : rightEvent.type === 'trap' ? '⚠️' : rightEvent.type === 'deadend' ? '🚧' : rightEvent.type === 'coins' ? '🪙' : rightEvent.type === 'buffStone' ? '🗿' : '❓'}}</text>
        <text class="title" style="font-size: 16px;">{{rightEvent.type === 'treasure' ? '宝箱' : rightEvent.type === 'spring' ? '生命泉水' : rightEvent.type === 'trap' ? (trapResult.dodged ? '闪避成功' : '触发陷阱') : rightEvent.type === 'deadend' ? '迷途岔路' : rightEvent.type === 'coins' ? '散落金币' : rightEvent.type === 'buffStone' ? '增益石碑' : ''}}</text>
        <text class="subtitle" style="font-size: 12px; color: {{rightEvent.type === 'trap' && !trapResult.dodged ? '#e74c3c' : rightEvent.type === 'spring' ? '#2ecc71' : '#f0c040'}};">
          {{rightEvent.type === 'treasure' ? '获得' + rightEvent.gold + '金币' : rightEvent.type === 'spring' ? '恢复' + rightEvent.heal + '生命' : rightEvent.type === 'trap' ? (trapResult.dodged ? '毫发无伤' : '受到' + trapResult.damage + '伤害') : rightEvent.type === 'deadend' ? '死胡同' : rightEvent.type === 'coins' ? '捡到' + rightEvent.gold + '金币' : rightEvent.type === 'buffStone' ? '攻击+' + rightEvent.attackBonus : ''}}
        </text>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 10px;" bindtap="finishRight">好的</button>
      </block>

      <!-- 怪物 -->
      <block wx:if="{{rightState === 'monster'}}">
        <text style="font-size: 30px; display: block;">👹</text>
        <text style="font-size: 15px; font-weight: bold; color: #e0c080; margin: 2px 0;">{{rightEvent.monster.name}}</text>
        <text style="font-size: 11px; color: #8a8a9a; margin: 1px 0;">{{rightEvent.monster.desc}}</text>
        <text style="font-size: 12px; color: #8a8a9a; margin: 3px 0;">❤️{{rightEvent.monster.hp}}  ⚔️{{rightEvent.monster.attack}}</text>
        <button class="btn-sm btn-sm-primary" bindtap="goBattleRight">⚔️ 战斗</button>
        <button class="btn-sm btn-sm-secondary" bindtap="runAwayRight">🏃 逃跑</button>
      </block>

      <!-- 商人 -->
      <block wx:if="{{rightState === 'merchant'}}">
        <text style="font-size: 36px; display: block;">🧙</text>
        <text class="title" style="font-size: 16px;">神秘商人</text>
        <view wx:for="{{rightEvent.items}}" wx:key="name" style="margin: 4px 0; padding: 6px; background: #1a1a2e; border-radius: 6px; width: 100%;">
          <view class="flex-between">
            <text style="color: #e0c080; font-size: 12px;">{{item.name}}</text>
            <view>
              <text style="color: #f0c040; font-size: 11px;">💰{{item.price}}</text>
              <button class="btn-sm btn-sm-gold" style="padding: 2px 8px; font-size: 11px; margin-left: 4px;" bindtap="buyItemRight" data-index="{{index}}">买</button>
            </view>
          </view>
        </view>
        <button class="btn-sm btn-sm-secondary" style="width: 80%; margin-top: 6px;" bindtap="finishRight">离开</button>
      </block>

      <!-- 营地 -->
      <block wx:if="{{rightState === 'camp'}}">
        <text style="font-size: 36px; display: block;">🏕️</text>
        <text class="title" style="font-size: 16px;">休息营地</text>
        <text class="subtitle" style="font-size: 11px;">30%概率遇怪</text>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 6px;" bindtap="doRestRight">🛌 休息</button>
        <button class="btn-sm btn-sm-secondary" style="width: 80%; margin-top: 4px;" bindtap="finishRight">离开</button>
      </block>

      <!-- 祭坛 -->
      <block wx:if="{{rightState === 'altar'}}">
        <text style="font-size: 36px; display: block;">🔮</text>
        <text class="title" style="font-size: 16px;">遗物祭坛</text>
        <text class="subtitle" style="font-size: 11px;">献祭{{rightEvent.cost}}血（{{rightEvent.altarCount}}/{{rightEvent.maxCount}}次）</text>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 4px;" bindtap="altarRight" data-type="attack" disabled="{{rightEvent.altarCount >= rightEvent.maxCount || player.hp <= rightEvent.cost}}">⚔️ +1攻击</button>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 2px;" bindtap="altarRight" data-type="defense" disabled="{{rightEvent.altarCount >= rightEvent.maxCount || player.hp <= rightEvent.cost}}">🛡️ +1防御</button>
        <button class="btn-sm btn-sm-secondary" style="width: 80%; margin-top: 2px;" bindtap="finishRight">离开</button>
      </block>

      <!-- 破旧装备 -->
      <block wx:if="{{rightState === 'oldGear'}}">
        <text style="font-size: 36px; display: block;">🦺</text>
        <text class="title" style="font-size: 16px;">破旧装备</text>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 4px;" bindtap="wearRight">👔 穿上 +{{rightEvent.defense}}防</button>
        <button class="btn-sm btn-sm-primary" style="width: 80%; margin-top: 2px;" bindtap="scrapRight">🔧 拆解 +{{rightEvent.gold}}金</button>
        <button class="btn-sm btn-sm-secondary" style="width: 80%; margin-top: 2px;" bindtap="finishRight">不理会</button>
      </block>

      <!-- 营地遇怪 -->
      <block wx:if="{{rightState === 'camp_ambush'}}">
        <text style="font-size: 30px; display: block;">👹</text>
        <text style="font-size: 14px; font-weight: bold; color: #e0c080; margin: 2px 0;">{{rightEvent.monster.name}}突袭！</text>
        <text style="font-size: 12px; color: #8a8a9a; margin: 3px 0;">❤️{{rightEvent.monster.hp}}</text>
        <button class="btn-sm btn-sm-primary" bindtap="goBattleRight">⚔️ 战斗</button>
        <button class="btn-sm btn-sm-secondary" bindtap="runAwayRight">🏃 逃跑</button>
      </block>

    </view>

    </view>
  </view>

  <!-- ========== 底部状态栏 ========== -->
  <view class="card" style="position: fixed; bottom: 0; left: 0; right: 0; margin: 0; border-radius: 12px 12px 0 0; padding: 12px 16px; z-index: 100;">
    <view class="flex-between">
      <view style="flex: 1; margin-right: 12px;">
        <view class="stat-row"><text class="stat-label">❤️ {{player.hp}} / {{totalMaxHp}}</text></view>
        <view class="hp-bar-wrap" style="margin: 4px 0;"><view class="hp-bar-fill" style="width: {{player.hp / totalMaxHp * 100}}%"></view></view>
        <view class="stat-row"><text class="stat-label">⚔️ {{totalAttack}}攻  🛡️ {{totalDefense}}防</text></view>
        <view class="stat-row" style="margin-top: 2px;"><text class="stat-label">💰 {{player.gold}}金币  ⭐ {{player.exp}} / {{expToLevel}}经验</text></view>
      </view>
      <button class="btn-sm btn-sm-secondary" style="width: auto; padding: 8px 18px; margin: 0; font-size: 14px;" bindtap="exitExplore">🚪 退出</button>
    </view>
  </view>

  <view style="height: 100px;"></view>

</view>
