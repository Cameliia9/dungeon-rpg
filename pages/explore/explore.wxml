<!-- 探索地牢页面 -->
<view class="container">

  <!-- ========== 顶部：楼层标题 ========== -->
  <view class="card" style="text-align: center;">
    <text class="title">🏰 地牢第 {{player.floor}} 层</text>
    <text class="subtitle">小心前进...</text>
  </view>

  <!-- ========== 中间主交互区 ========== -->

  <!-- 状态一：双岔路口，选择方向 -->
  <view wx:if="{{!currentChoice}}" class="card" style="text-align: center;">
    <text style="font-size: 40px; display: block; margin: 10px 0;">🚪</text>
    <text style="color: #8a8a9a; display: block; margin-bottom: 20px;">前方出现岔路口，选择一条路...</text>
    <view style="display: flex; justify-content: space-around;">
      <button class="btn btn-primary" style="width: 36%;" bindtap="goLeft">
        ⬅️ 向左探索
      </button>
      <button class="btn btn-primary" style="width: 36%;" bindtap="goRight">
        ➡️ 向右探索
      </button>
    </view>
  </view>

  <!-- 状态二：已选方向，显示事件（自动类） -->
  <view wx:if="{{currentChoice && !currentInteraction}}" class="card">

    <!-- 怪物 -->
    <block wx:if="{{activeEvent.type === 'monster'}}">
      <text style="font-size: 36px; display: block; text-align: center;">👹</text>
      <text class="title">{{activeEvent.monster.name}} 出现了！</text>
      <text class="subtitle">{{activeEvent.monster.desc}}</text>
      <view class="stat-row"><text class="stat-label">怪物血量</text><text class="stat-value">{{activeEvent.monster.hp}}</text></view>
      <view class="stat-row"><text class="stat-label">怪物攻击</text><text class="stat-value">{{activeEvent.monster.attack}}</text></view>
      <button class="btn btn-primary" bindtap="goBattle">⚔️ 战斗！</button>
      <button class="btn btn-secondary" bindtap="runAway">🏃 逃跑（50%成功率）</button>
    </block>

    <!-- 宝箱 -->
    <block wx:if="{{activeEvent.type === 'treasure'}}">
      <text style="font-size: 36px; display: block; text-align: center;">📦</text>
      <text class="title">发现了宝箱！</text>
      <text class="subtitle" style="color: #f0c040;">获得 {{activeEvent.gold}} 金币</text>
      <button class="btn btn-primary" bindtap="nextRound">➡️ 继续前进</button>
    </block>

    <!-- 生命泉水 -->
    <block wx:if="{{activeEvent.type === 'spring'}}">
      <text style="font-size: 36px; display: block; text-align: center;">💧</text>
      <text class="title">生命泉水</text>
      <text class="subtitle" style="color: #2ecc71;">饮用泉水，恢复了 {{activeEvent.heal}} 点生命</text>
      <button class="btn btn-primary" bindtap="nextRound">➡️ 继续前进</button>
    </block>

    <!-- 陷阱机关 -->
    <block wx:if="{{activeEvent.type === 'trap'}}">
      <text style="font-size: 36px; display: block; text-align: center;">⚠️</text>
      <text class="title">{{trapResult.dodged ? '闪避成功！' : '触发陷阱！'}}</text>
      <text class="subtitle" wx:if="{{!trapResult.dodged}}" style="color: #e74c3c;">尖刺陷阱造成了 {{trapResult.damage}} 点伤害</text>
      <text class="subtitle" wx:if="{{trapResult.dodged}}" style="color: #2ecc71;">你敏捷地躲开了陷阱，毫发无伤！</text>
      <button class="btn btn-primary" bindtap="nextRound">➡️ 继续前进</button>
    </block>

    <!-- 迷途岔路 -->
    <block wx:if="{{activeEvent.type === 'deadend'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🚧</text>
      <text class="title">迷途岔路</text>
      <text class="subtitle" style="color: #8a8a9a;">这是一条死胡同，你安全返回了岔路口</text>
      <button class="btn btn-primary" bindtap="nextRound">➡️ 继续前进</button>
    </block>

    <!-- 散落金币 -->
    <block wx:if="{{activeEvent.type === 'coins'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🪙</text>
      <text class="title">散落金币</text>
      <text class="subtitle" style="color: #f0c040;">你发现了 {{activeEvent.gold}} 枚金币！</text>
      <button class="btn btn-primary" bindtap="nextRound">➡️ 继续前进</button>
    </block>

    <!-- 增益石碑 -->
    <block wx:if="{{activeEvent.type === 'buffStone'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🗿</text>
      <text class="title">增益石碑</text>
      <text class="subtitle" style="color: #e0c080;">石碑的力量涌入体内，攻击力 +{{activeEvent.attackBonus}}！（本次探索有效）</text>
      <button class="btn btn-primary" bindtap="nextRound">➡️ 继续前进</button>
    </block>

    <!-- 神秘商人 -->
    <block wx:if="{{activeEvent.type === 'merchant'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🧙</text>
      <text class="title">神秘商人</text>
      <text class="subtitle">"冒险者，看看我的货物吧！"</text>
      <view wx:for="{{activeEvent.items}}" wx:key="name" style="margin: 10px 0; padding: 10px; background: #1a1a2e; border-radius: 8px;">
        <view class="flex-between">
          <view>
            <text style="color: #e0c080;">{{item.name}}</text>
            <text style="color: #8a8a9a; font-size: 12px; display: block;">{{item.desc}}</text>
          </view>
          <view style="text-align: right;">
            <text style="color: #f0c040;">💰{{item.price}}</text>
            <button class="btn btn-gold" style="padding: 6px 14px; font-size: 12px; margin-top: 4px;" bindtap="buyItem" data-index="{{index}}">购买</button>
          </view>
        </view>
      </view>
      <button class="btn btn-secondary" bindtap="nextRound">🚶 离开商人</button>
    </block>

    <!-- 休息营地 -->
    <block wx:if="{{activeEvent.type === 'camp'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🏕️</text>
      <text class="title">休息营地</text>
      <text class="subtitle">发现了一个废弃营地，可以在此休息</text>
      <text style="color: #e74c3c; display: block; text-align: center; margin: 8px 0;">⚠️ 休息有30%概率遭遇巡逻怪物</text>
      <button class="btn btn-primary" bindtap="doRest">🛌 休息（回满生命）</button>
      <button class="btn btn-secondary" bindtap="nextRound">🚶 离开营地</button>
    </block>

    <!-- 遗物祭坛 -->
    <block wx:if="{{activeEvent.type === 'altar'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🔮</text>
      <text class="title">遗物祭坛</text>
      <text class="subtitle">献祭 {{activeEvent.sacrifice}} 点生命值，换取永久力量</text>
      <button class="btn btn-primary" bindtap="altarSacrifice" data-type="attack">⚔️ 换取 +1 攻击力</button>
      <button class="btn btn-primary" bindtap="altarSacrifice" data-type="defense">🛡️ 换取 +1 防御力</button>
      <button class="btn btn-secondary" bindtap="nextRound">🚶 离开祭坛</button>
    </block>

    <!-- 破旧装备 -->
    <block wx:if="{{activeEvent.type === 'oldGear'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🦺</text>
      <text class="title">破旧装备</text>
      <text class="subtitle">翻到了一件还能用的旧装备</text>
      <button class="btn btn-primary" bindtap="wearOldGear">👔 穿上（临时 +{{activeEvent.defense}} 防御）</button>
      <button class="btn btn-primary" bindtap="scrapOldGear">🔧 拆解换 {{activeEvent.gold}} 金币</button>
      <button class="btn btn-secondary" bindtap="nextRound">🚶 不理会</button>
    </block>

    <!-- 营地遭遇怪物 -->
    <block wx:if="{{activeEvent.type === 'camp_ambush'}}">
      <text style="font-size: 36px; display: block; text-align: center;">👹</text>
      <text class="title">{{activeEvent.monster.name}} 突袭了营地！</text>
      <text class="subtitle">{{activeEvent.monster.desc}}</text>
      <view class="stat-row"><text class="stat-label">怪物血量</text><text class="stat-value">{{activeEvent.monster.hp}}</text></view>
      <view class="stat-row"><text class="stat-label">怪物攻击</text><text class="stat-value">{{activeEvent.monster.attack}}</text></view>
      <button class="btn btn-primary" bindtap="goBattle">⚔️ 战斗！</button>
      <button class="btn btn-secondary" bindtap="runAway">🏃 逃跑（50%成功率）</button>
    </block>

  </view>

  <!-- 下楼 -->
  <view wx:if="{{canDescend}}" class="card" style="text-align: center;">
    <text style="font-size: 40px; display: block;">🪜</text>
    <text class="title">发现通往下层的楼梯！</text>
    <button class="btn btn-gold" bindtap="descend">
      ⬇️ 前往第 {{player.floor + 1}} 层
    </button>
  </view>

  <!-- ========== 底部状态栏 ========== -->
  <view class="card" style="position: fixed; bottom: 0; left: 0; right: 0; margin: 0; border-radius: 12px 12px 0 0; padding: 12px 16px; z-index: 100;">
    <view class="flex-between">
      <view>
        <view class="stat-row">
          <text class="stat-label">❤️ {{player.hp}} / {{totalMaxHp}}</text>
        </view>
        <view class="stat-row" style="margin-top: 2px;">
          <text class="stat-label">⚔️ {{totalAttack}}攻  🛡️ {{totalDefense}}防</text>
        </view>
        <view class="stat-row" style="margin-top: 2px;">
          <text class="stat-label">💰 {{player.gold}}金币  ⭐ {{player.exp}} / {{expToLevel}}经验</text>
        </view>
      </view>
      <button class="btn btn-secondary" style="width: auto; padding: 8px 18px; margin: 0; font-size: 14px;" bindtap="exitExplore">
        🚪 退出探索
      </button>
    </view>
  </view>

  <!-- 底部占位 -->
  <view style="height: 100px;"></view>

</view>
