<!-- 探索地牢页面 -->
<view class="container">
  <!-- 当前层数 -->
  <view class="card" style="text-align: center;">
    <text class="title">🏰 地牢第 {{player.floor}} 层</text>
    <text class="subtitle">小心前进...</text>
  </view>

  <!-- 快速状态 -->
  <view class="card">
    <view class="stat-row">
      <text class="stat-label">❤️</text>
      <text class="stat-value">{{player.hp}} / {{totalMaxHp}}</text>
    </view>
    <view class="stat-row">
      <text class="stat-label">⚔️</text>
      <text class="stat-value">{{totalAttack}}攻  {{totalDefense}}防</text>
    </view>
  </view>

  <!-- 探索房间 -->
  <view wx:if="{{!event}}" class="card" style="text-align: center;">
    <text style="font-size: 40px; display: block; margin: 20px 0;">🚪</text>
    <text style="color: #8a8a9a;">前方有一扇门，推开它...</text>
    <button class="btn btn-primary" bindtap="explore" style="margin-top: 20px;">
      🔍 探索房间
    </button>
  </view>

  <!-- 事件结果 -->
  <view wx:if="{{event}}" class="card">
    <!-- 怪物事件 -->
    <block wx:if="{{event.type === 'monster'}}">
      <text style="font-size: 36px; display: block; text-align: center;">👹</text>
      <text class="title">{{event.monster.name}} 出现了！</text>
      <text class="subtitle">{{event.monster.desc}}</text>
      <view class="stat-row">
        <text class="stat-label">怪物血量</text>
        <text class="stat-value">{{event.monster.hp}}</text>
      </view>
      <view class="stat-row">
        <text class="stat-label">怪物攻击</text>
        <text class="stat-value">{{event.monster.attack}}</text>
      </view>
      <button class="btn btn-primary" bindtap="goBattle">
        ⚔️ 战斗！
      </button>
      <button class="btn btn-secondary" bindtap="runAway">
        🏃 逃跑（50%成功率）
      </button>
    </block>

    <!-- 宝箱 -->
    <block wx:if="{{event.type === 'treasure'}}">
      <text style="font-size: 36px; display: block; text-align: center;">📦</text>
      <text class="title">发现了宝箱！</text>
      <text class="subtitle" style="color: #f0c040;">获得 {{event.gold}} 金币</text>
      <button class="btn btn-primary" bindtap="nextRoom">
        ➡️ 继续前进
      </button>
    </block>

    <!-- 休息点 -->
    <block wx:if="{{event.type === 'rest'}}">
      <text style="font-size: 36px; display: block; text-align: center;">🏕️</text>
      <text class="title">找到一个安全的角落</text>
      <text class="subtitle" style="color: #2ecc71;">恢复了 {{event.heal}} 点生命</text>
      <button class="btn btn-primary" bindtap="nextRoom">
        ➡️ 继续前进
      </button>
    </block>

    <!-- 装备掉落 -->
    <block wx:if="{{event.type === 'equipment'}}">
      <text style="font-size: 36px; display: block; text-align: center;">✨</text>
      <text class="title">拾取了装备！</text>
      <text class="subtitle" style="color: #a080ff;">
        {{event.item.name}}（{{event.item.desc}}）
      </text>
      <view wx:if="{{event.item.type === 'weapon'}}">
        <text style="color: #c8c8d0;">攻击力 +{{event.item.attack}}</text>
      </view>
      <view wx:elif="{{event.item.type === 'armor'}}">
        <text style="color: #c8c8d0;">防御力 +{{event.item.defense}}</text>
      </view>
      <view wx:elif="{{event.item.type === 'accessory'}}">
        <text style="color: #c8c8d0;">生命上限 +{{event.item.hp}}</text>
      </view>
      <button class="btn btn-primary" bindtap="nextRoom">
        ➡️ 继续前进
      </button>
    </block>

    <!-- 陷阱 -->
    <block wx:if="{{event.type === 'trap'}}">
      <text style="font-size: 36px; display: block; text-align: center;">⚠️</text>
      <text class="title">踩到陷阱！</text>
      <text class="subtitle" style="color: #e74c3c;">受到了 {{event.damage}} 点伤害</text>
      <button class="btn btn-primary" bindtap="nextRoom">
        ➡️ 继续前进
      </button>
    </block>
  </view>

  <!-- 下楼 -->
  <view wx:if="{{canDescend}}" class="card" style="text-align: center;">
    <text style="font-size: 40px; display: block;">🪜</text>
    <text class="title">发现通往下层的楼梯！</text>
    <button class="btn btn-gold" bindtap="descend">
      ⬇️ 前往第 {{player.floor + 1}} 层
    </button>
  </view>

  <!-- 返回 -->
  <button class="btn btn-secondary" bindtap="goBack">
    ↩️ 返回主页
  </button>
</view>
