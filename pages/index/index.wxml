<!-- 主页 -->
<view class="container">
  <!-- 标题 -->
  <view class="card" style="text-align: center;">
    <text class="title">⚔️ 地牢冒险 ⚔️</text>
    <text class="subtitle">第 {{player.floor}} 层 · Lv.{{player.level}}</text>
  </view>

  <!-- 角色状态 -->
  <view class="card">
    <view class="stat-row">
      <text class="stat-label">❤️ 生命值</text>
      <text class="stat-value">{{player.hp}} / {{totalMaxHp}}</text>
    </view>
    <view class="hp-bar-wrap">
      <view class="hp-bar-fill" style="width: {{hpPercent}}%"></view>
    </view>

    <view class="stat-row">
      <text class="stat-label">✨ 经验值</text>
      <text class="stat-value">{{player.exp}} / {{expToLevel}}</text>
    </view>
    <view class="exp-bar-wrap">
      <view class="exp-bar-fill" style="width: {{expPercent}}%"></view>
    </view>

    <view class="stat-row">
      <text class="stat-label">⚔️ 攻击力</text>
      <text class="stat-value">{{totalAttack}}</text>
    </view>
    <view class="stat-row">
      <text class="stat-label">🛡️ 防御力</text>
      <text class="stat-value">{{totalDefense}}</text>
    </view>
    <view class="stat-row">
      <text class="stat-label">💰 金币</text>
      <text class="stat-value">{{player.gold}}</text>
    </view>
    <view class="stat-row">
      <text class="stat-label">💀 击杀数</text>
      <text class="stat-value">{{player.kills}}</text>
    </view>

    <!-- 装备一览 -->
    <view style="margin-top: 12px; font-size: 13px; color: #a080ff;">
      <view>🗡️ 武器：{{player.weapon ? player.weapon.name + ' (+' + player.weapon.attack + '攻)' : '无'}}</view>
      <view>🛡️ 护甲：{{player.armor ? player.armor.name + ' (+' + player.armor.defense + '防)' : '无'}}</view>
      <view>💍 饰品：{{player.accessory ? player.accessory.name + ' (+' + player.accessory.hp + '血)' : '无'}}</view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <button class="btn btn-primary" bindtap="goExplore">
    🏰 探索地牢
  </button>
  <button class="btn btn-secondary" bindtap="goInventory">
    🎒 背包 ({{player.inventory.length}}件)
  </button>
  <button class="btn btn-gold" bindtap="goShop">
    🏪 商店
  </button>

  <view wx:if="{{player.isDead()}}" class="card" style="text-align: center;">
    <text style="color: #e74c3c; font-size: 18px;">💀 你倒下了...</text>
    <button class="btn btn-danger" bindtap="restart" style="margin-top: 12px;">
      🔄 重新开始
    </button>
  </view>
</view>
