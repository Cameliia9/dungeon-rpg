/* 全局样式 - 暗黑地牢风格 */
page {
  background-color: #0f0f1a;
  color: #c8c8d0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  min-height: 100vh;
}

/* 通用容器 */
.container {
  padding: 20px;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  border: 1px solid #2a2a4a;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 16px;
}

/* 标题 */
.title {
  font-size: 20px;
  font-weight: bold;
  color: #e0c080;
  text-align: center;
  margin-bottom: 16px;
}

.subtitle {
  display: block;
  font-size: 14px;
  color: #8a8a9a;
  text-align: center;
  margin-bottom: 12px;
}

/* 按钮 */
.btn {
  display: block;
  width: 100%;
  padding: 14px;
  border-radius: 8px;
  text-align: center;
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 12px;
  border: none;
  transition: all 0.2s;
}

.btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-primary {
  background: linear-gradient(135deg, #c0392b, #e74c3c);
  color: white;
}

.btn-secondary {
  background: linear-gradient(135deg, #2c3e50, #34495e);
  color: #ccc;
}

.btn-gold {
  background: linear-gradient(135deg, #d4a017, #f0c040);
  color: #1a1a2e;
}

.btn-danger {
  background: linear-gradient(135deg, #8b0000, #c0392b);
  color: white;
}

/* Boss 战卡片 */
.boss-card {
  border: 1px solid #ff5555 !important;
  box-shadow: 0 0 12px rgba(255, 85, 85, 0.35) !important;
}

/* 属性条 */
.stat-row {
  display: flex;
  justify-content: space-between;
  margin: 6px 0;
  font-size: 14px;
}

.stat-label {
  color: #8a8a9a;
}

.stat-value {
  color: #e0c080;
  font-weight: bold;
}

/* 进度条 */
.hp-bar-wrap {
  background: #2a1a1a;
  border-radius: 6px;
  height: 12px;
  margin: 8px 0;
  overflow: hidden;
}

.hp-bar-fill {
  background: linear-gradient(90deg, #c0392b, #e74c3c);
  height: 100%;
  border-radius: 6px;
  transition: width 0.3s;
}

.exp-bar-wrap {
  background: #1a1a2e;
  border-radius: 6px;
  height: 8px;
  margin: 8px 0;
  overflow: hidden;
}

.exp-bar-fill {
  background: linear-gradient(90deg, #2980b9, #3498db);
  height: 100%;
  border-radius: 6px;
  transition: width 0.3s;
}

/* 消息日志 */
.log {
  margin-top: 16px;
  max-height: 200px;
  overflow-y: auto;
}

.log-item {
  padding: 4px 0;
  font-size: 13px;
  border-bottom: 1px solid #1a1a2e;
  color: #8a8a9a;
}

.log-damage {
  color: #e74c3c;
}

.log-crit {
  color: #ffaa00;
  font-weight: bold;
}

.log-dodge {
  color: #3498db;
}

.log-poison {
  color: #9b59b6;
}

.log-heal {
  color: #2ecc71;
}

.log-loot {
  color: #f0c040;
}

.log-info {
  color: #3498db;
}

.log-level {
  color: #e0c080;
  font-weight: bold;
}

/* 装备槽颜色 */
.equip-slot {
  color: #a080ff;
}

/* flex工具 */
.flex-row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

/* 主卡片右上方飞出 */
.fly-out-right {
  animation: flyOut 0.5s ease-out forwards;
}

@keyframes flyOut {
  from { transform: translate(0, 0) rotate(0deg); opacity: 1; }
  to   { transform: translate(32px, -50px) rotate(12deg); opacity: 0; }
}

/* 小按钮（探索卡片内用） */
.btn-sm {
  display: block;
  width: 68%;
  padding: 7px;
  border-radius: 6px;
  text-align: center;
  font-size: 13px;
  font-weight: bold;
  margin: 3px auto;
  border: none;
}
.btn-sm:active { transform: scale(0.97); opacity: 0.9; }
.btn-sm-primary { background: linear-gradient(135deg, #c0392b, #e74c3c); color: white; }
.btn-sm-secondary { background: linear-gradient(135deg, #2c3e50, #34495e); color: #ccc; }
.btn-sm-gold { background: linear-gradient(135deg, #d4a017, #f0c040); color: #1a1a2e; }
.btn-sm-danger { background: linear-gradient(135deg, #8b0000, #ff4444); color: white; }
.btn-sm-forge { background: linear-gradient(135deg, #b34700, #ff8c1a); color: white; }

/* ==================== 入场动画 ==================== */
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(40px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fadeSlideDown {
  from { opacity: 0; transform: translateY(-30px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideInLeft {
  from { opacity: 0; transform: translateX(-60px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes slideInRight {
  from { opacity: 0; transform: translateX(60px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 难度卡片：交错渐显+上滑 */
.anim-card {
  animation: fadeSlideUp 0.45s ease both;
}

/* 探索页：顶部标题下滑入 */
.anim-header {
  animation: fadeSlideDown 0.4s ease both;
}

/* 探索页：左门左滑入 */
.anim-left {
  animation: slideInLeft 0.45s ease both;
}

/* 探索页：右门右滑入 */
.anim-right {
  animation: slideInRight 0.45s ease both;
}

/* 探索页：底部状态栏上滑入 */
.anim-footer {
  animation: fadeSlideUp 0.5s ease both;
}

/* 淡入（通用） */
.anim-fade {
  animation: fadeIn 0.35s ease both;
}
